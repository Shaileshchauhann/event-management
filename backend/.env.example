# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# DynamoDB Table Names
ADMINS_TABLE=AdminsTable
EVENTS_TABLE=EventsTable
TICKETS_TABLE=TicketsTable
VERIFICATION_CODES_TABLE=VerificationCodesTable
PAYMENTS_TABLE=PaymentsTable

# Auth & Communication
JWT_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:000000000000:secret:JwtSecret
SENDER_EMAIL=tickets@example.com
ALLOWED_ORIGIN=*
FRONTEND_BASE_URL=http://localhost:5174
